{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#infra/*": "./src/infra/*",
    "#controllers/*": "./src/v1/controllers/*",
    "#models/*": "./src/v1/models/*",
    "#routes/*": "./src/v1/routes/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "trap \"npm run services:stop\" INT EXIT; npm run services:up && npm run services:wait:database && npm run migrations:up && cross-env NODE_ENV=development nodemon src/server.js",
    "test": "npm run services:up && concurrently -n node,jest --hide node -k -s command-jest \"cross-env NODE_ENV=test node src/server.js\" \"node --experimental-vm-modules node_modules/.bin/jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "services:wait:database": "node src/infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint ./src",
    "migrations:create": "node-pg-migrate -m src/infra/migrations create",
    "migrations:up": "dotenv -e .env.development -- node-pg-migrate -m src/infra/migrations up",
    "migrations:up:dry": "dotenv -e .env.development -- node-pg-migrate -m src/infra/migrations --dry-run up",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.2",
    "chalk": "5.6.2",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "dotenv-expand": "12.0.3",
    "express": "5.1.0",
    "node-pg-migrate": "8.0.3",
    "nodemailer": "^7.0.9",
    "pg": "8.16.3",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.37.0",
    "@faker-js/faker": "10.0.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-cli": "10.0.0",
    "eslint": "9.37.0",
    "eslint-plugin-jest": "29.0.1",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "set-cookie-parser": "2.7.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
