{
  "name": "wolfit",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "trap \"npm run services:stop\" INT EXIT; npm run services:up && npm run services:wait:database && npm run migrations:up && nodemon src/server.js",
    "test": "npm run services:up && concurrently -n node,jest --hide node -k -s command-jest \"node src/server.js\" \"node --experimental-vm-modules node_modules/.bin/jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "services:wait:database": "node src/infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint ./src",
    "migrations:create": "node-pg-migrate -m src/infra/migrations create",
    "migrations:up": "dotenv -e .env.development -- node-pg-migrate -m src/infra/migrations up",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "1.3.3",
    "chalk": "5.6.0",
    "dotenv": "17.2.1",
    "dotenv-expand": "12.0.2",
    "express": "5.1.0",
    "node-pg-migrate": "8.0.3",
    "pg": "8.16.3",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.33.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv-cli": "10.0.0",
    "eslint": "9.33.0",
    "eslint-plugin-jest": "29.0.1",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "jest": "30.0.5",
    "nodemon": "3.1.10",
    "prettier": "3.6.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
